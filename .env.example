# Google AI Studio で発行（無料枠）: https://aistudio.google.com/apikey
# 未設定でもモックモードで動作します（ルールベース採点のみ）
GEMINI_API_KEY=

# 無料枠で使えるモデル。枠の上限・対象モデルは変わるため AI Studio で確認してください
GEMINI_MODEL=gemini-2.5-flash

# Jev（TypeSafe AI）: 意図の振り分けと採点の数値化に使う。早期アクセス経由で発行
# 未設定なら ルール / Gemini で代替します
# 料金: 入力 $0.042 / 100万トークン、出力無料（2026年9月時点の報道値。無料枠の有無は未確認）
# 注意: 設定すると会話内容が TypeSafe AI に送信されます
TYPESAFE_API_KEY=
